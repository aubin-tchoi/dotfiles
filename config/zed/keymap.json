[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-0": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-0": "git_panel::ToggleFocus",
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-shift-d": "git::Branch"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-0": "git_panel::ToggleFocus",
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-shift-d": "git::Branch"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-0": "git_panel::ToggleFocus",
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-shift-d": "git::Branch"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-0": "git_panel::ToggleFocus",
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-shift-d": "git::Branch"
    }
  },
  {
    "context": "Editor",
    "bindings": {
